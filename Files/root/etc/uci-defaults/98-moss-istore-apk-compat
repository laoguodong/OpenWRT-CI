#!/bin/sh
# MOSS: iStore/opkg compatibility for apk-based OpenWrt/ImmortalWrt builds.
# Fixes iStore dependency checks on apk firmware where /usr/lib/opkg/status
# is absent/incomplete and /bin/is-opkg derives state from a temporary opkg root.

export PATH=/sbin:/usr/sbin:/bin:/usr/bin:/usr/local/sbin:/usr/local/bin

command -v apk >/dev/null 2>&1 || exit 0
[ -f /etc/apk/arch ] || exit 0

seed_apk_status_dir() {
	local root="$1"
	local status="$root/usr/lib/opkg/status"
	local info_dir="$root/usr/lib/opkg/info"
	local pkg line ver arch

	mkdir -p "$info_dir"
	[ -f "$status" ] || : > "$status"

	for pkg in libc procd ubus uci opkg bash curl tar coreutils mount-utils block-mount \
		lsblk blkid e2fsprogs parted smartmontools smartd swap-utils zoneinfo-asia \
		docker dockerd containerd runc docker-compose luci-lib-docker luci-app-dockerman \
		docker-deps taskd script-utils coreutils-stty \
		luci-base luci-compat luci-lib-ipkg luci-lib-taskd luci-lib-xterm \
		rpcd uhttpd uhttpd-mod-ubus ucode \
		rpcd-mod-file rpcd-mod-iwinfo rpcd-mod-luci rpcd-mod-ucode \
		ucode-mod-fs ucode-mod-ubus ucode-mod-uci ucode-mod-uloop \
		luci-app-diskman app-meta-diskman; do
		grep -q "^Package: ${pkg}$" "$status" 2>/dev/null && continue
		line=$(apk list -I 2>/dev/null | grep -m1 "^${pkg}-") || continue
		ver=${line#${pkg}-}
		ver=${ver%% *}
		arch=$(printf '%s\n' "$line" | cut -d' ' -f2)
		[ -n "$arch" ] || arch=$(cat /etc/apk/arch 2>/dev/null | head -1)
		cat >> "$status" <<EOF
Package: ${pkg}
Version: ${ver}
Architecture: ${arch}
Status: install user installed

EOF
		touch "$info_dir/${pkg}.list"
	done
}

patch_is_opkg() {
	local file="/bin/is-opkg"
	local marker="MOSS_APK_ISTORE_COMPAT"

	[ -f "$file" ] || return 0
	grep -q "$marker" "$file" 2>/dev/null && return 0

	cp -a "$file" "$file.bak-moss-apk-compat-$(date +%Y%m%d-%H%M%S)" 2>/dev/null || true

	# Add architecture fallback for apk builds if missing.
	if ! grep -q '/etc/apk/arch' "$file" 2>/dev/null; then
		awk '
			{ print }
			/ARCH=`sed -n -e/ {
				print "[ -z \"$ARCH\" ] && ARCH=`cat /etc/apk/arch 2>/dev/null | head -1`"
				print "[ -z \"$ARCH\" ] && ARCH=`apk --print-arch 2>/dev/null`"
				print "[ -z \"$ARCH\" ] && ARCH=`. /etc/openwrt_release 2>/dev/null; echo $DISTRIB_ARCH`"
			}
		' "$file" > /tmp/is-opkg.arch.$$ && cat /tmp/is-opkg.arch.$$ > "$file" && rm -f /tmp/is-opkg.arch.$$
	fi

	# Inject apk status seeding after is_init initializes /tmp/is-root.
	awk -v marker="$marker" '
		$0 == "is_init >/dev/null 2>&1" && !done {
			print "seed_apk_status_dir() { # " marker
			print "    local root=\"$1\""
			print "    command -v apk >/dev/null 2>&1 || return 0"
			print "    [ -f /etc/apk/arch ] || return 0"
			print "    mkdir -p \"$root/usr/lib/opkg/info\""
			print "    [ -f \"$root/usr/lib/opkg/status\" ] || : > \"$root/usr/lib/opkg/status\""
			print "    local pkg line ver arch"
			print "    for pkg in libc procd ubus uci opkg bash curl tar coreutils mount-utils block-mount lsblk blkid e2fsprogs parted smartmontools smartd swap-utils zoneinfo-asia docker dockerd containerd runc docker-compose luci-lib-docker luci-app-dockerman docker-deps taskd script-utils coreutils-stty luci-base luci-compat luci-lib-ipkg luci-lib-taskd luci-lib-xterm rpcd uhttpd uhttpd-mod-ubus ucode rpcd-mod-file rpcd-mod-iwinfo rpcd-mod-luci rpcd-mod-ucode ucode-mod-fs ucode-mod-ubus ucode-mod-uci ucode-mod-uloop luci-app-diskman app-meta-diskman; do"
			print "        grep -q \"^Package: ${pkg}$\" \"$root/usr/lib/opkg/status\" 2>/dev/null && continue"
			print "        line=$(apk list -I 2>/dev/null | grep -m1 \"^${pkg}-\") || continue"
			print "        ver=${line#${pkg}-}; ver=${ver%% *}"
			print "        arch=$(printf '\''%s\\n'\'' \"$line\" | cut -d'\'' '\'' -f2)"
			print "        [ -n \"$arch\" ] || arch=\"$ARCH\""
			print "        { echo \"Package: ${pkg}\"; echo \"Version: ${ver}\"; echo \"Architecture: ${arch}\"; echo \"Status: install user installed\"; echo; } >> \"$root/usr/lib/opkg/status\""
			print "        touch \"$root/usr/lib/opkg/info/${pkg}.list\""
			print "    done"
			print "}"
			print ""
			print
			print "seed_apk_status_dir \"${IS_ROOT}\" >/dev/null 2>&1"
			print "seed_apk_status_dir \"\" >/dev/null 2>&1"
			done=1
			next
		}
		{ print }
	' "$file" > /tmp/is-opkg.compat.$$ && cat /tmp/is-opkg.compat.$$ > "$file" && rm -f /tmp/is-opkg.compat.$$
	chmod 0755 "$file"
	sh -n "$file" || cp -a "$file".bak-moss-apk-compat-* "$file" 2>/dev/null || true
}

seed_apk_status_dir ""
patch_is_opkg

exit 0
