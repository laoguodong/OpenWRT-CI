#!/bin/sh
# MOSS: NN6000 v2 first-boot overlay expansion.
# Conservative mode: reclaim only unused vendor placeholder partitions
# plugin/log/swap, then let luci-app-partexp create and mount /overlay.

export PATH=/sbin:/usr/sbin:/bin:/usr/bin:/usr/local/sbin:/usr/local/bin

LOG=/root/moss-auto-overlay-expand.log
MARK=/etc/moss-auto-overlay-expanded
DISK=/dev/mmcblk0
BOARD="$(cat /tmp/sysinfo/board_name 2>/dev/null || board_name 2>/dev/null || true)"

log() {
	printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG"
}

part_label() {
	parted -s "$DISK" print 2>/dev/null | awk -v n="$1" '$1 == n {print $NF}'
}

part_exists() {
	[ -b "${DISK}p$1" ]
}

part_mounted_or_swap() {
	local dev="${DISK}p$1"
	mount | grep -q "^$dev " && return 0
	grep -q "^$dev[[:space:]]" /proc/swaps 2>/dev/null && return 0
	return 1
}

# Only intended for this router class.
[ "$BOARD" = "link,nn6000-v2" ] || exit 0
[ -b "$DISK" ] || exit 0
[ -x /usr/bin/partexp ] || exit 0
[ -e "$MARK" ] && exit 0

log "start board=$BOARD disk=$DISK"

# If an expanded overlay partition already exists, do not touch partition layout.
# Existing p27 cannot be expanded forward safely after deleting p24-p26.
if part_exists 27 || mount | grep -q '^/dev/mmcblk0p2[4-9] .* /overlay '; then
	log "skip: expanded overlay partition already exists"
	touch "$MARK"
	exit 0
fi

# Require exact stock placeholder labels before deleting anything.
if [ "$(part_label 24)" != "plugin" ] || [ "$(part_label 25)" != "log" ] || [ "$(part_label 26)" != "swap" ]; then
	log "skip: partition labels mismatch p24=$(part_label 24) p25=$(part_label 25) p26=$(part_label 26)"
	exit 0
fi

for n in 24 25 26; do
	if part_mounted_or_swap "$n"; then
		log "skip: ${DISK}p$n is mounted or active swap"
		exit 0
	fi
done

# Capture preflight state for recovery/debugging.
{
	echo '=== parted before ==='
	parted -s "$DISK" unit MiB print free 2>&1
	echo '=== df before ==='
	df -hT 2>&1
	echo '=== block before ==='
	block info 2>&1
} >> "$LOG"

# Delete from high to low to keep numbering predictable before partexp creates the next partition.
for n in 26 25 24; do
	log "remove partition $n ($(part_label $n))"
	parted -s "$DISK" rm "$n" >> "$LOG" 2>&1 || {
		log "failed removing partition $n"
		exit 0
	}
done

# Ask kernel to re-read partition table where possible. Ignore failures; partexp/fdisk may still see it.
partprobe "$DISK" >> "$LOG" 2>&1 || true
blockdev --rereadpt "$DISK" >> "$LOG" 2>&1 || true
sleep 3

# Configure partexp to create a new ext4 overlay partition and preserve existing config.
uci -q set partexp.global=global
uci -q set partexp.global.target_function='/overlay'
uci -q set partexp.global.target_disk='mmcblk0'
uci -q set partexp.global.keep_config='1'
uci -q set partexp.global.format_type='ext4'
uci commit partexp

log "run partexp autopart"
/usr/bin/partexp autopart >> "$LOG" 2>&1
RC=$?
log "partexp rc=$RC"

{
	echo '=== parted after ==='
	parted -s "$DISK" unit MiB print free 2>&1
	echo '=== fstab after ==='
	cat /etc/config/fstab 2>&1
	echo '=== block after ==='
	block info 2>&1
} >> "$LOG"

# partexp returns 2 for success/reboot-needed in its own flow.
if [ "$RC" = "2" ] || grep -q "扩容成功" /var/partexp/bkpartexp.log 2>/dev/null; then
	touch "$MARK"
	log "success: reboot required for new /overlay"
else
	log "warning: partexp did not report success"
fi

exit 0
